@inherits LayoutComponentBase
@using Nebula.Client.Services
@using Nebula.Shared.Models
@implements IDisposable
@inject GameConnectionManager GameManager
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="brand-mark">Nebula Syndicate</span>
            <div class="top-actions">
                <span class="link-status @(GameManager.IsConnected ? "on" : "off")">
                    @(GameManager.IsConnected ? "Uplink live" : "Offline")
                </span>
                <a class="top-chip" href="howto">How to play</a>
                <a class="top-chip accent" href="lobby">Play</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    @foreach (var toast in _activeToasts)
    {
        var bgClass = toast.Type switch {
            NotificationType.Success => "bg-success",
            NotificationType.Warning => "bg-warning text-dark",
            NotificationType.Alert => "bg-danger",
            _ => "bg-dark text-info border-info"
        };

        <div class="toast show @bgClass text-white fade-in" role="alert">
            <div class="toast-header bg-transparent text-white border-bottom border-light">
                <strong class="me-auto">@toast.Title</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="() => RemoveToast(toast)"></button>
            </div>
            <div class="toast-body fw-bold">
                @toast.Message
            </div>
        </div>
    }
</div>

@code {
    private List<NotificationPayload> _activeToasts = new();

    protected override void OnInitialized()
    {
        GameManager.OnGlobalNotificationReceived += HandleNotification;
        GameManager.OnStateChanged += OnConnChanged;
        Nav.LocationChanged += OnLoc;
    }

    private void OnConnChanged() => InvokeAsync(StateHasChanged);
    private void OnLoc(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void HandleNotification(NotificationPayload payload)
    {
        _activeToasts.Add(payload);
        InvokeAsync(StateHasChanged);

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await InvokeAsync(() => RemoveToast(payload));
        });
    }

    private void RemoveToast(NotificationPayload payload)
    {
        if (_activeToasts.Contains(payload))
        {
            _activeToasts.Remove(payload);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        GameManager.OnGlobalNotificationReceived -= HandleNotification;
        GameManager.OnStateChanged -= OnConnChanged;
        Nav.LocationChanged -= OnLoc;
    }
}
