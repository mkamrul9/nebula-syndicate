@page "/store"
@using System.Net.Http.Json
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="nebula-page">
    <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-2 mb-4">
        <div>
            <h2 class="text-warning mb-0">Black market</h2>
            <a class="small" href="editions">Need coins? See editions.</a>
        </div>
        <h4 class="text-success mb-0">@_balance coins</h4>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_catalog == null)
    {
        <div class="spinner-border text-warning" role="status"></div>
    }
    else if (_catalog.Items.Count == 0)
    {
        <div class="alert alert-secondary">The black market has nothing listed.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in _catalog.Items)
            {
                <div class="col-md-3 mb-4">
                    <div class="card bg-dark border-secondary h-100 text-center">
                        <div class="card-img-top bg-black p-4 text-info font-monospace">
                            [ @item.AssetRef ]
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="text-white">@item.Name</h5>
                            <p class="text-muted small flex-grow-1">@item.Description</p>

                            @if (item.IsOwned)
                            {
                                <button class="btn @(item.IsEquipped ? "btn-success" : "btn-outline-light") mt-2"
                                        disabled="@_busy"
                                        @onclick="() => EquipItem(item.Id)">
                                    @(item.IsEquipped ? "EQUIPPED" : "EQUIP")
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-warning mt-2 fw-bold" disabled="@_busy" @onclick="() => BuyItem(item.Id)">
                                    BUY (@item.PriceInCoins coins)
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private StoreCatalogDto? _catalog;
    private int _balance;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalog();
    }

    private async Task LoadCatalog()
    {
        _error = null;
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            _error = "Sign in from Login to open the black market.";
            _catalog = new StoreCatalogDto();
            return;
        }

        try
        {
            var response = await Http.GetAsync("api/store");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _error = "Session expired. Sign in again from Login.";
                _catalog = new StoreCatalogDto();
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                _catalog = new StoreCatalogDto();
                return;
            }

            _catalog = await response.Content.ReadFromJsonAsync<StoreCatalogDto>() ?? new StoreCatalogDto();
            _balance = _catalog.Balance;
        }
        catch (Exception ex)
        {
            _error = $"Could not open the black market. {ex.Message}";
            _catalog = new StoreCatalogDto();
        }
    }

    private async Task BuyItem(int itemId)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsync($"api/store/buy/{itemId}", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                return;
            }
            await LoadCatalog();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EquipItem(int itemId)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsync($"api/store/equip/{itemId}", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                return;
            }
            await LoadCatalog();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class StoreCatalogDto
    {
        public int Balance { get; set; }
        public List<StoreItemDto> Items { get; set; } = new();
    }

    private sealed class StoreItemDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int PriceInCoins { get; set; }
        public string AssetRef { get; set; } = string.Empty;
        public bool IsOwned { get; set; }
        public bool IsEquipped { get; set; }
    }
}
