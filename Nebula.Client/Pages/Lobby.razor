@* File: Nebula.Client/Pages/Lobby.razor *@
@page "/lobby"
@using Nebula.Client.Services
@implements IDisposable
@inject GameConnectionManager GameManager
@inject NavigationManager NavManager

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 text-center">
            <h1 class="display-4 text-warning">NEBULA SYNDICATE</h1>
            <p class="lead">Corporate Extractor Terminal</p>

            <div class="card bg-dark text-light border-secondary mt-4 p-5">
                @if (!GameManager.IsConnected)
                {
                    <div class="spinner-border text-primary" role="status"></div>
                    <h4 class="mt-3">Establishing Uplink to Syndicate Servers...</h4>
                }
                else if (_isQueued)
                {
                    <div class="spinner-grow text-danger" role="status"></div>
                    <h4 class="mt-3 text-danger">Searching for Rivals...</h4>
                    <p class="text-muted">Stay on this frequency. Deployment is imminent.</p>
                }
                else
                {
                    <h4 class="text-success mb-4">Uplink Established. Ready for deployment.</h4>
                    <button class="btn btn-danger btn-lg px-5 py-3 fw-bold" @onclick="JoinQueue">
                        ENTER MATCHMAKING
                    </button>
                }
            </div>
        </div>

        <div class="col-md-4">
            @* We reuse the Global Chat built in Phase 10 here *@
            <GlobalChatWidget /> 
        </div>
    </div>
</div>

@code {
    private bool _isQueued = false;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to state changes and routing events
        GameManager.OnMatchJoined += HandleMatchJoined;
        
        if (!GameManager.IsConnected)
        {
            await GameManager.ConnectAsync();
        }
    }

    private async Task JoinQueue()
    {
        _isQueued = true;
        await GameManager.JoinMatchQueue();
    }

    private void HandleMatchJoined(string matchId)
    {
        // The server found a match! Route the user to the game arena.
        // We use InvokeAsync because SignalR events fire on a background thread,
        // but NavigationManager must be called on the UI thread.
        InvokeAsync(() => NavManager.NavigateTo($"/arena/{matchId}"));
    }

    public void Dispose()
    {
        // CRITICAL: Prevent memory leaks
        GameManager.OnMatchJoined -= HandleMatchJoined;
    }
}
