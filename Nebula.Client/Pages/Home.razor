@page "/"
@using Nebula.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager

<PageTitle>Nebula Syndicate - Login</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-body p-4">
                    <h2 class="text-center text-warning mb-4">NEBULA TERMINAL</h2>
                    <p class="text-muted text-center mb-4">Enter your credentials to access the Syndicate Uplink.</p>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger">@_errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-secondary">Commander ID</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary" @bind="_loginDto.Username" />
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label text-secondary">Passcode</label>
                        <input type="password" class="form-control bg-dark text-light border-secondary" @bind="_loginDto.Password" />
                    </div>

                    <button class="btn btn-warning w-100 fw-bold" @onclick="AttemptLogin" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        AUTHENTICATE
                    </button>
                    <div class="mt-3 text-center text-muted small">
                        New commanders will be automatically registered upon first authentication.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginDto _loginDto = new LoginDto();
    private bool _isLoading = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Auto-redirect if already logged in
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrEmpty(token))
        {
            NavManager.NavigateTo("/lobby");
        }
    }

    private async Task AttemptLogin()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            // Assuming the server is running on localhost:5168
            var response = await Http.PostAsJsonAsync("http://localhost:5168/api/auth/login", _loginDto);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    await LocalStorage.SetItemAsync("authToken", result.Token);
                    NavManager.NavigateTo("/lobby");
                }
            }
            else
            {
                _errorMessage = "Authentication failed. Invalid credentials.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}
