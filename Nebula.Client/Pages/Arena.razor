@* File: Nebula.Client/Pages/Arena.razor *@
@page "/arena/{MatchId}"
@using Nebula.Client.Services
@using Nebula.Shared.Models
@implements IDisposable
@inject GameConnectionManager GameManager
@inject NavigationManager NavManager

@if (_latestState?.Status == GameStatus.Finished)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 d-flex justify-content-center align-items-center" style="z-index: 1050;">
        <div class="card bg-black border border-warning p-5 text-center shadow-lg" style="min-width: 400px;">
            @if (_myState?.Credits >= 50000.0m)
            {
                <h1 class="text-success display-3 fw-bold mb-3">VICTORY</h1>
                <p class="lead text-light">Extraction Rights Secured.</p>
            }
            else
            {
                <h1 class="text-danger display-3 fw-bold mb-3">DEFEAT</h1>
                <p class="lead text-light">Your syndicate has been liquidated.</p>
            }
            <hr class="border-secondary" />
            <h4 class="text-warning">Final Credits: ₡@Math.Floor(_myState?.Credits ?? 0)</h4>
            
            <button class="btn btn-outline-warning mt-4" @onclick='() => NavManager.NavigateTo("/lobby")'>
                RETURN TO LOBBY
            </button>
        </div>
    </div>
}

@if (_latestState == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-info" role="status"></div>
        <h3 class="mt-3">Synchronizing telemetry with Arena...</h3>
    </div>
}
else
{
    <div class="container-fluid bg-dark text-light min-vh-100 p-4">
        <div class="row">
            <!-- Left Column: Player Resources -->
            <div class="col-md-3">
                <div class="card bg-secondary text-white mb-3">
                    <div class="card-header border-bottom border-info fw-bold">
                        MY SYNDICATE
                    </div>
                    <!-- Apply the EMP visual override dynamically -->
                    <div class="card-body @(_myState != null && _myState.IsEmpMuted ? "emp-overlay" : "")">
                        @if (_myState != null)
                        {
                            @if (_myState.IsEmpMuted)
                            {
                                <!-- Calculate remaining seconds based on server ticks (assuming 10 ticks/sec) -->
                                var remainingTicks = _myState.EmpExpirationTick - _latestState!.CurrentTick;
                                var remainingSeconds = Math.Max(0, remainingTicks / 10.0);
                                
                                <div class="alert bg-dark border-danger glitch-text mb-3">
                                    SYSTEMS OFFLINE<br />
                                    REBOOTING IN: @remainingSeconds.ToString("F1")s
                                </div>
                            }

                            <h2 class="text-warning">₡ @Math.Floor(_myState.Credits)</h2>
                            <hr />
                            
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5>Ironium <span class="badge bg-secondary">@_myState.ActiveIroniumDrones Active</span></h5>
                                    <p class="text-muted small mb-0">Stockpile: @Math.Floor(_myState.Ironium)</p>
                                </div>
                                <!-- Action Button -->
                                <button class="btn btn-sm btn-outline-secondary" 
                                        disabled="@(!CanAffordDrone || _isActionLocked || _myState.IsEmpMuted)"
                                        @onclick="@(() => HandleDeployClick("Ironium"))">
                                    DEPLOY (₡500)
                                </button>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5>Plasma <span class="badge bg-info">@_myState.ActivePlasmaDrones Active</span></h5>
                                    <p class="text-muted small mb-0">Stockpile: @Math.Floor(_myState.Plasma)</p>
                                </div>
                                <!-- Action Button -->
                                <button class="btn btn-sm btn-outline-info" 
                                        disabled="@(!CanAffordDrone || _isActionLocked || _myState.IsEmpMuted)"
                                        @onclick="@(() => HandleDeployClick("Plasma"))">
                                    DEPLOY (₡500)
                                </button>
                            </div>

                            <div class="mt-4 p-3 bg-dark border border-secondary rounded">
                                <h5>Defensive Systems</h5>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-info fw-bold">Active Firewalls: @_myState.FirewallCharges</span>
                                    </div>
                                    
                                    <!-- Firewall costs physical resources, not Credits! -->
                                    <button class="btn btn-sm btn-outline-light" 
                                            disabled="@(!CanAffordFirewall || _isActionLocked || _myState.IsEmpMuted)"
                                            @onclick="HandleBuildFirewall">
                                        BUILD FIREWALL (150 Fe / 50 Pl)
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Middle Column: The Live Market -->
            <div class="col-md-6">
                <div class="card bg-dark border-primary">
                    <div class="card-header border-bottom border-primary text-center fw-bold">
                        GLOBAL MARKET (Tick: @_latestState.CurrentTick)
                    </div>
                    <div class="card-body d-flex justify-content-around text-center">
                        @if (_latestState.MarketPrices.ContainsKey("Ironium"))
                        {
                            <div>
                                <h4 class="text-info">Ironium</h4>
                                <h2>₡ @_latestState.MarketPrices["Ironium"].ToString("F2")</h2>
                            </div>
                        }
                        @if (_latestState.MarketPrices.ContainsKey("Plasma"))
                        {
                            <div>
                                <h4 class="text-danger">Plasma</h4>
                                <h2>₡ @_latestState.MarketPrices["Plasma"].ToString("F2")</h2>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Opponent Intel -->
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-header border-bottom border-dark fw-bold">
                        RIVAL INTEL & OFFENSE
                    </div>
                    <div class="card-body">
                        @foreach (var opp in _opponents)
                        {
                            <div class="mb-3 border-bottom border-dark pb-3">
                                <h6>@opp.Value.PlayerName 
                                    @if(!opp.Value.IsConnected) { <span class="badge bg-warning text-dark">OFFLINE</span> }
                                    @if(opp.Value.IsEmpMuted) { <span class="badge bg-dark text-danger blink">EMP'D</span> }
                                </h6>
                                <div class="small text-light mb-2">
                                    Ironium Drones: @opp.Value.ActiveIroniumDrones | Plasma Drones: @opp.Value.ActivePlasmaDrones
                                </div>
                                
                                <!-- 1-Click Sabotage Button -->
                                <button class="btn btn-sm btn-dark text-danger w-100 fw-bold border-danger"
                                        disabled="@(!CanAffordEmp || _isActionLocked || _myState!.IsEmpMuted)"
                                        @onclick="@(() => HandleSabotageClick(opp.Key, SabotageType.EMP))">
                                    LAUNCH EMP (₡2000)
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string MatchId { get; set; } = string.Empty;

    private GameState? _latestState;
    private PlayerState? _myState;
    private List<KeyValuePair<string, PlayerState>> _opponents = new();
    
    private string _myPlayerId = string.Empty;
    private DateTime _lastRender = DateTime.MinValue;

    private const decimal DroneCost = 500.0m;
    private const decimal EmpCost = 2000.0m;
    private bool _isActionLocked = false;

    // Local validation property
    private bool CanAffordDrone => _myState != null && _myState.Credits >= DroneCost;
    private bool CanAffordEmp => _myState != null && _myState.Credits >= EmpCost;
    private bool CanAffordFirewall => _myState != null && 
                                      _myState.Ironium >= 150 && 
                                      _myState.Plasma >= 50;

    private async Task HandleDeployClick(string resource)
    {
        if (!CanAffordDrone || _isActionLocked) return;

        // 1. Lock the UI instantly to prevent double-clicks
        _isActionLocked = true;

        // 2. Transmit command to server queue
        await GameManager.DispatchDroneAsync(resource);

        // 3. Keep locked just long enough for the server to process and send a new tick
        await Task.Delay(200); 
        _isActionLocked = false;
        
        // No StateHasChanged() needed here because HandleGameState 
        // fires every 100-200ms anyway and will redraw the unlocked button.
    }

    private async Task HandleSabotageClick(string targetId, SabotageType type)
    {
        if (!CanAffordEmp || _isActionLocked) return;

        _isActionLocked = true;
        await GameManager.LaunchSabotageAsync(targetId, type);
        
        // Brief local lock to prevent double-spending UI bugs
        await Task.Delay(200);
        _isActionLocked = false;
    }

    private async Task HandleBuildFirewall()
    {
        if (!CanAffordFirewall || _isActionLocked) return;

        _isActionLocked = true;
        await GameManager.BuildDefenseAsync(DefenseType.Firewall); 
        await Task.Delay(200);
        _isActionLocked = false;
    }

    protected override async Task OnInitializedAsync()
    {
        _myPlayerId = await GameManager.GetCurrentPlayerIdAsync();
        
        GameManager.OnGameStateUpdated += HandleGameState;
    }

    private void HandleGameState(GameState state)
    {
        // 1. Validate this tick is for our current match
        if (state.MatchId != MatchId) return;

        _latestState = state;
        
        // 2. Separate "Me" from "Opponents"
        if (state.Players.TryGetValue(_myPlayerId, out var mine))
        {
            _myState = mine;
        }
        _opponents = state.Players.Where(p => p.Key != _myPlayerId).ToList();

        // 3. UI Render Throttling (Render max 5 times a second to save CPU)
        if ((DateTime.UtcNow - _lastRender).TotalMilliseconds > 200)
        {
            _lastRender = DateTime.UtcNow;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        GameManager.OnGameStateUpdated -= HandleGameState;
    }
}
