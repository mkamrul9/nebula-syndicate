@* File: Nebula.Client/Pages/CommanderDashboard.razor *@
@page "/dashboard"
@using Nebula.Client.Services
@using Nebula.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject GameConnectionManager GameManager
@inject AuthenticationStateProvider AuthStateProvider

<h3>Commander Dashboard</h3>

@if (_myState != null)
{
    <div class="resource-panel border p-3 mt-3">
        <h5>Resources</h5>
        <ul>
            <li class="text-success">Credits: ₡@Math.Floor(_myState.Credits)</li>
            <li class="text-secondary">Ironium: @Math.Floor(_myState.Ironium) kg 
                <small>(+@(_myState.ActiveIroniumDrones * 2)/sec)</small>
            </li>
            <li class="text-info">Plasma: @Math.Floor(_myState.Plasma) L 
                <small>(+@(_myState.ActivePlasmaDrones * 0.5)/sec)</small>
            </li>
        </ul>
    </div>
}
else
{
    <p>Waiting for match data... Are you in a match?</p>
}

@code {
    private PlayerState? _myState;
    private string? _myPlayerId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _myPlayerId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        GameManager.OnGameStateUpdated += HandleGameStateUpdated;
        
        if (!GameManager.IsConnected)
        {
            await GameManager.ConnectAsync();
        }
    }

    private void HandleGameStateUpdated(GameState state)
    {
        if (_myPlayerId != null && state.Players.TryGetValue(_myPlayerId, out var myState))
        {
            _myState = myState;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        GameManager.OnGameStateUpdated -= HandleGameStateUpdated;
    }
}
