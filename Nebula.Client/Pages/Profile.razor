@* File: Nebula.Client/Pages/Profile.razor *@
@page "/profile"
@using Nebula.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="nebula-page">
    <h2 class="text-warning mb-4">Commander Profile</h2>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_stats == null)
    {
        @if (string.IsNullOrEmpty(_error))
        {
            <div class="spinner-border text-primary" role="status"></div>
        }
    }
    else
    {
        <div class="row">
            <!-- Stats Card -->
            <div class="col-md-4">
                <div class="card bg-dark border-info text-white">
                    <div class="card-body text-center">
                        <h4 class="card-title text-info">@_stats.Username</h4>
                        <hr class="border-secondary"/>
                        <div class="display-6">@_stats.WinRate%</div>
                        <div class="text-muted small mb-3">WIN RATE</div>
                        
                        <div class="d-flex justify-content-between px-3">
                            <div>
                                <h5 class="mb-0">@_stats.TotalMatchesPlayed</h5>
                                <small class="text-muted">MATCHES</small>
                            </div>
                            <div>
                                <h5 class="text-success mb-0">@_stats.TotalWins</h5>
                                <small class="text-muted">WINS</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- History Table -->
            <div class="col-md-8">
                <div class="card bg-dark border-secondary text-white">
                    <div class="card-header fw-bold">Recent Operations</div>
                    <div class="card-body p-0">
                        <table class="table table-dark table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Result</th>
                                    <th>Duration</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var match in _history)
                                {
                                    <tr>
                                        <td>
                                            @if (match.IsVictory)
                                            {
                                                <span class="badge bg-success">VICTORY</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">DEFEAT</span>
                                            }
                                        </td>
                                        <td>@(match.DurationSeconds / 60)m @(match.DurationSeconds % 60)s</td>
                                        <td>@match.EndedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-info" href="/replay/@match.MatchId">
                                                Watch Replay
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mt-4">
            <div class="card bg-dark border-warning text-white">
                <div class="card-header fw-bold">Daily Contracts</div>
                <div class="card-body">
                    @if (_quests.Count == 0)
                    {
                        <div class="text-muted">No active contracts.</div>
                    }
                    @foreach (var quest in _quests)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom border-secondary py-2">
                            <div>
                                <div>@quest.Description</div>
                                <small class="text-muted">@quest.CurrentValue / @quest.TargetValue · @quest.RewardCredits coins</small>
                            </div>
                            @if (quest.IsClaimed)
                            {
                                <span class="badge bg-secondary">CLAIMED</span>
                            }
                            else if (quest.IsCompleted)
                            {
                                <button class="btn btn-sm btn-warning" @onclick="() => ClaimQuest(quest.Id)">CLAIM</button>
                            }
                            else
                            {
                                <span class="badge bg-dark border border-secondary">IN PROGRESS</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private PlayerStatsDto? _stats;
    private List<MatchHistoryItemDto> _history = new();
    private List<QuestDto> _quests = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            _error = "Sign in from Login to open your profile.";
            return;
        }

        try
        {
            var statsResponse = await Http.GetAsync("api/profile/stats");
            if (statsResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _error = "Session expired. Sign in again from Login.";
                return;
            }
            if (!statsResponse.IsSuccessStatusCode)
            {
                _error = await statsResponse.Content.ReadAsStringAsync();
                return;
            }

            _stats = await statsResponse.Content.ReadFromJsonAsync<PlayerStatsDto>();

            var historyData = await Http.GetFromJsonAsync<List<MatchHistoryItemDto>>("api/profile/history?page=1&pageSize=10");
            if (historyData != null)
                _history = historyData;

            var quests = await Http.GetFromJsonAsync<List<QuestDto>>("api/quests");
            if (quests != null)
                _quests = quests;
        }
        catch (Exception ex)
        {
            _error = $"Could not load profile. {ex.Message}";
        }
    }

    private async Task ClaimQuest(Guid questId)
    {
        var response = await Http.PostAsync($"api/quests/{questId}/claim", null);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Could not claim that contract.";
            return;
        }

        _error = null;
        var quests = await Http.GetFromJsonAsync<List<QuestDto>>("api/quests");
        if (quests != null)
            _quests = quests;
    }

    private sealed class QuestDto
    {
        public Guid Id { get; set; }
        public string Description { get; set; } = string.Empty;
        public int TargetValue { get; set; }
        public int CurrentValue { get; set; }
        public int RewardCredits { get; set; }
        public bool IsClaimed { get; set; }
        public bool IsCompleted { get; set; }
    }
}
